[
  {
    "id": "mcp-crm",
    "name": "CRM tools server",
    "hosted_on": "support-chat",
    "auth": "service_token",
    "listen": "internal",
    "tools": [
      {
        "name": "crm.read_customer",
        "access": "read"
      },
      {
        "name": "crm.update_customer",
        "access": "write"
      },
      {
        "name": "email.send",
        "access": "send_external"
      }
    ]
  },
  {
    "id": "mcp-ops",
    "name": "Ops tools server",
    "hosted_on": "build-01",
    "auth": "none",
    "listen": "0.0.0.0:8080",
    "tools": [
      {
        "name": "shell.exec",
        "access": "execute"
      },
      {
        "name": "aws.cli",
        "access": "admin"
      },
      {
        "name": "k8s.apply",
        "access": "write"
      }
    ]
  },
  {
    "id": "mcp-erp",
    "name": "ERP tools server",
    "hosted_on": "finance-erp",
    "auth": "service_token",
    "listen": "internal",
    "tools": [
      {
        "name": "erp.match_invoice",
        "access": "write"
      },
      {
        "name": "erp.update_vendor_bank",
        "access": "write"
      },
      {
        "name": "erp.schedule_payment",
        "access": "payment"
      }
    ]
  },
  {
    "id": "mcp-remote-client",
    "name": "mcp-remote 0.1.15 (client proxy)",
    "hosted_on": "dev-laptops",
    "auth": "n/a",
    "listen": "local",
    "package": "mcp-remote@0.1.15",
    "tools": []
  },
  {
    "id": "mcp-inspector",
    "name": "MCP Inspector 0.13.0 (debug tool)",
    "hosted_on": "dev-laptops",
    "auth": "none",
    "listen": "0.0.0.0:6277",
    "package": "@modelcontextprotocol/inspector@0.13.0",
    "tools": []
  }
]
